+/*
+ * Persistent Sagit bring-up indicator.  The framebuffer console clears only
+ * fbcon_width pixels, leaving this right-hand stripe outside the scrolling
+ * text area.  Keep a separate 16x16 tile for each reached checkpoint.
+ */
+void
+sweet_fbcon_stage(unsigned int stage)
+{
+	static const uint32_t colors[] = {
+		0xff000000u, 0xffff0000u, 0xffff8000u,
+		0xffffff00u, 0xff00ff00u, 0xff00ffffu
+	};
+	if (fbcon_base == NULL || fbcon_status_x == 0 || stage == 0 || stage > 26) {
+		return;
+	}
+	uint32_t color = stage < 6 ? colors[stage] : FBCON_FG;
+	for (uint32_t y = (stage - 1) * 24; y < stage * 24 - 8 && y < fbcon_height; y++) {
+		volatile uint32_t *line = fbcon_base + y * (fbcon_stride / 4);
+		for (uint32_t x = fbcon_status_x + 12; x < fbcon_status_x + 28; x++) {
+			line[x] = color;
+		}
+	}
+}
